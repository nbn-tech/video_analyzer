# Set real key in .env (or .env.local). Do NOT commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
WHISPER_MODEL=small
WHISPER_CHUNK_SEC=60
WHISPER_PARALLEL_WORKERS=3
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0.0
OCR_ENABLED=true
OCR_ENGINE=paddleocr
OCR_INTERVAL_SEC=1.0
OCR_PARALLEL_WORKERS=4
OCR_MIN_CHARS=8
OCR_TESSERACT_CMD=tesseract
OCR_LANGUAGES=jpn+eng
OCR_PADDLE_MIN_SCORE=0.7
OCR_PADDLE_MIN_BOX_WIDTH=40
OCR_PADDLE_MIN_BOX_HEIGHT=16
OCR_PADDLE_MAX_BOX_HEIGHT=220
OCR_TEXT_VALID_CHAR_RATIO=0.55
OCR_TEXT_MIN_JAPANESE_RATIO=0.2
OCR_JAPANESE_ONLY=true
OCR_MIN_PERSIST_FRAMES=2
OCR_REGION_MATCH_TEXT_SIM=0.82
OCR_REGION_MATCH_X_PX=120
OCR_REGION_MATCH_Y_PX=80
OCR_USE_GPU=auto
GEMINI_PAYLOAD_DUMP=true
GEMINI_PAYLOAD_DUMP_DIR=app/data/debug_payloads
MIN_CORNER_SEC=20
MERGE_GAP_SEC=2
DATABASE_URL=sqlite:///./app/data/video_analyzer.db

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReceiveVideoJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-1:656445866169:video-analyzer-queue"
    },
    {
      "Sid": "ReadInputVideos",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bangumi-info/movie/*"
    },
    {
      "Sid": "WriteAnalysisResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::bangumi-info/results/*",
        "arn:aws:s3:::bangumi-info/reports/*",
        "arn:aws:s3:::bangumi-info/athena-data/*"
      ]
    },
    {
      "Sid": "ReadExistingDailyParquet",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::bangumi-info/results/*",
        "arn:aws:s3:::bangumi-info/athena-data/*"
      ]
    },
    {
      "Sid": "ListDailyParquet",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bangumi-info",
      "Condition": {
        "StringLike": {
          "s3:prefix": "athena-data/*"
        }
      }
    }
  ]
}

[
 {
  "start_sec": 0.0,
  "end_sec": 62.0,
  "text": "You"
 },
 {
  "start_sec": 90.0,
  "end_sec": 92.0,
  "text": "なかおかさんとタブちゃん"
 },
 {
  "start_sec": 92.0,
  "end_sec": 98.0,
  "text": "なかおかさん"
 },
 {
  "start_sec": 98.0,
  "end_sec": 100.0,
  "text": "軽筆でもこうやって結構な人が歩いてるんだな"
 },
 {
  "start_sec": 100.0,
  "end_sec": 102.0,
  "text": "すごい"
 },
 {
  "start_sec": 102.0,
  "end_sec": 104.0,
  "text": "いいお天気ですね"
 },
 {
  "start_sec": 104.0,
  "end_sec": 106.0,
  "text": "素敵な"
 },
 {
  "start_sec": 106.0,
  "end_sec": 108.0,
  "text": "ナイスカップルですね"
 },
 {
  "start_sec": 108.0,
  "end_sec": 110.0,
  "text": "カップルじゃない?"
 },
 {
  "start_sec": 110.0,
  "end_sec": 112.0,
  "text": "なんで?"
 },
 {
  "start_sec": 112.0,
  "end_sec": 118.0,
  "text": "なかおかさん"
 },
 {
  "start_sec": 118.0,
  "end_sec": 119.0,
  "text": "カプロじゃない?"
 },
 {
  "start_sec": 119.0,
  "end_sec": 120.0,
  "text": "え?"
 },
 {
  "start_sec": 120.0,
  "end_sec": 121.0,
  "text": "なんだよ"
 },
 {
  "start_sec": 120.0,
  "end_sec": 125.0,
  "text": "お友達でお友達同士で一緒に会ったのですよ"
 },
 {
  "start_sec": 125.0,
  "end_sec": 127.0,
  "text": "地元の友達とかですか"
 },
 {
  "start_sec": 127.0,
  "end_sec": 131.0,
  "text": "特技を持ってる人探してるんですよ"
 },
 {
  "start_sec": 131.0,
  "end_sec": 134.0,
  "text": "なんすか?どうすか?"
 },
 {
  "start_sec": 134.0,
  "end_sec": 138.0,
  "text": "言ってください"
 },
 {
  "start_sec": 138.0,
  "end_sec": 141.0,
  "text": "最近帰ってきたから取らなくていい"
 },
 {
  "start_sec": 141.0,
  "end_sec": 143.0,
  "text": "なんすか?最近帰ってきた理由"
 },
 {
  "start_sec": 143.0,
  "end_sec": 146.0,
  "text": "海外にいて帰ってきたばっかり"
 },
 {
  "start_sec": 146.0,
  "end_sec": 148.0,
  "text": "海外いてたんすか?どこに?"
 },
 {
  "start_sec": 148.0,
  "end_sec": 148.66,
  "text": "どこに?"
 },
 {
  "start_sec": 148.66,
  "end_sec": 149.42000000000002,
  "text": "ラオス"
 },
 {
  "start_sec": 149.42000000000002,
  "end_sec": 149.92000000000002,
  "text": "ラオス?"
 },
 {
  "start_sec": 150.0,
  "end_sec": 151.0,
  "text": "ランス?"
 },
 {
  "start_sec": 151.0,
  "end_sec": 152.0,
  "text": "ランス"
 },
 {
  "start_sec": 152.0,
  "end_sec": 153.0,
  "text": "どれくらい行ってたんすか?"
 },
 {
  "start_sec": 153.0,
  "end_sec": 155.0,
  "text": "2年4ヶ月"
 },
 {
  "start_sec": 155.0,
  "end_sec": 156.0,
  "text": "2年4ヶ月?それはなんで?"
 },
 {
  "start_sec": 156.0,
  "end_sec": 159.0,
  "text": "ザイカ海外協力隊でボランティアで"
 },
 {
  "start_sec": 159.0,
  "end_sec": 161.0,
  "text": "すご?"
 },
 {
  "start_sec": 161.0,
  "end_sec": 163.0,
  "text": "素敵やね"
 },
 {
  "start_sec": 163.0,
  "end_sec": 164.0,
  "text": "どういうことをしてた?"
 },
 {
  "start_sec": 164.0,
  "end_sec": 166.0,
  "text": "バレーボールを"
 },
 {
  "start_sec": 166.0,
  "end_sec": 169.0,
  "text": "向こうの体育大学で教えて"
 },
 {
  "start_sec": 169.0,
  "end_sec": 170.0,
  "text": "子どもたち?"
 },
 {
  "start_sec": 170.0,
  "end_sec": 171.0,
  "text": "そうです"
 },
 {
  "start_sec": 171.0,
  "end_sec": 172.0,
  "text": "体育大学で"
 },
 {
  "start_sec": 180.0,
  "end_sec": 184.0,
  "text": "その時の写真みたいなのない?見せてもらいたいな"
 },
 {
  "start_sec": 184.0,
  "end_sec": 187.0,
  "text": "なんか素敵だねって言えるようなやつが"
 },
 {
  "start_sec": 187.0,
  "end_sec": 188.0,
  "text": "像乗りました"
 },
 {
  "start_sec": 188.0,
  "end_sec": 189.0,
  "text": "現地の風着て"
 },
 {
  "start_sec": 189.0,
  "end_sec": 192.0,
  "text": "貸し出し用の濡れてもらいました"
 },
 {
  "start_sec": 192.0,
  "end_sec": 193.0,
  "text": "像乗って"
 },
 {
  "start_sec": 193.0,
  "end_sec": 195.0,
  "text": "で像使いの免許取りました"
 },
 {
  "start_sec": 195.0,
  "end_sec": 196.0,
  "text": "え?嘘?"
 },
 {
  "start_sec": 196.0,
  "end_sec": 197.0,
  "text": "何それ?"
 },
 {
  "start_sec": 197.0,
  "end_sec": 198.0,
  "text": "免許にあれ"
 },
 {
  "start_sec": 198.0,
  "end_sec": 200.0,
  "text": "立って座って行けぐらいです"
 },
 {
  "start_sec": 200.0,
  "end_sec": 201.0,
  "text": "できるの?"
 },
 {
  "start_sec": 201.0,
  "end_sec": 203.0,
  "text": "ちなみに今僕を像飛び立てて"
 },
 {
  "start_sec": 203.0,
  "end_sec": 204.0,
  "text": "できますか?"
 },
 {
  "start_sec": 204.0,
  "end_sec": 205.0,
  "text": "いいっすな顔がさ"
 },
 {
  "start_sec": 205.0,
  "end_sec": 206.0,
  "text": "覚えてる"
 },
 {
  "start_sec": 206.0,
  "end_sec": 208.0,
  "text": "覚えてなさすが"
 },
 {
  "start_sec": 208.0,
  "end_sec": 210.0,
  "text": "ハギズメみたいな"
 },
 {
  "start_sec": 210.0,
  "end_sec": 212.0,
  "text": "本格的なやつはね"
 },
 {
  "start_sec": 212.0,
  "end_sec": 214.0,
  "text": "持ってねーだろ今"
 },
 {
  "start_sec": 214.0,
  "end_sec": 216.0,
  "text": "うわーうるさ"
 },
 {
  "start_sec": 216.0,
  "end_sec": 218.0,
  "text": "うるさ"
 },
 {
  "start_sec": 218.0,
  "end_sec": 220.0,
  "text": "一人だとどうなんだろう"
 },
 {
  "start_sec": 220.0,
  "end_sec": 222.0,
  "text": "こっちのお店あるかな"
 },
 {
  "start_sec": 222.0,
  "end_sec": 224.0,
  "text": "めちゃめちゃマジで"
 },
 {
  "start_sec": 224.0,
  "end_sec": 226.0,
  "text": "市街地ですよ"
 },
 {
  "start_sec": 228.0,
  "end_sec": 230.0,
  "text": "人は減りますね"
 },
 {
  "start_sec": 230.0,
  "end_sec": 232.0,
  "text": "人は減りますよ"
 },
 {
  "start_sec": 234.0,
  "end_sec": 235.0,
  "text": "ああこんにちは"
 },
 {
  "start_sec": 235.0,
  "end_sec": 236.0,
  "text": "待ってほら急に"
 },
 {
  "start_sec": 236.0,
  "end_sec": 238.0,
  "text": "めちゃくちゃオシャレなお店あるから"
 },
 {
  "start_sec": 238.0,
  "end_sec": 240.0,
  "text": "子供服かな?"
 },
 {
  "start_sec": 240.0,
  "end_sec": 241.0,
  "text": "かわいい"
 },
 {
  "start_sec": 241.0,
  "end_sec": 243.0,
  "text": "ちょっと聞いてみよう話"
 },
 {
  "start_sec": 243.0,
  "end_sec": 244.0,
  "text": "あらがあらが"
 },
 {
  "start_sec": 244.0,
  "end_sec": 245.0,
  "text": "すいません"
 },
 {
  "start_sec": 245.0,
  "end_sec": 246.0,
  "text": "こんにちは"
 },
 {
  "start_sec": 246.0,
  "end_sec": 248.0,
  "text": "お子さんのお洋服ですか?"
 },
 {
  "start_sec": 248.0,
  "end_sec": 249.0,
  "text": "私が子供帰ってて"
 },
 {
  "start_sec": 249.0,
  "end_sec": 252.0,
  "text": "主人がアイスクリームやアイスを作ってるんですけど"
 },
 {
  "start_sec": 252.0,
  "end_sec": 253.0,
  "text": "隣ですか?"
 },
 {
  "start_sec": 253.0,
  "end_sec": 254.0,
  "text": "そうですそうです"
 },
 {
  "start_sec": 254.0,
  "end_sec": 255.0,
  "text": "一緒にやってて"
 },
 {
  "start_sec": 255.0,
  "end_sec": 257.0,
  "text": "じゃあお店が2つ今並んでる状況ですか?"
 },
 {
  "start_sec": 257.0,
  "end_sec": 258.0,
  "text": "そうです"
 },
 {
  "start_sec": 258.0,
  "end_sec": 259.0,
  "text": "でここは火曜日しかやってないんで"
 },
 {
  "start_sec": 259.0,
  "end_sec": 260.0,
  "text": "今日火曜日"
 },
 {
  "start_sec": 260.0,
  "end_sec": 261.0,
  "text": "あっこっちの"
 },
 {
  "start_sec": 261.0,
  "end_sec": 262.0,
  "text": "火曜日しかやってない"
 },
 {
  "start_sec": 262.0,
  "end_sec": 263.0,
  "text": "玉玉?"
 },
 {
  "start_sec": 263.0,
  "end_sec": 264.0,
  "text": "そうです"
 },
 {
  "start_sec": 264.0,
  "end_sec": 265.0,
  "text": "これはついてる"
 },
 {
  "start_sec": 265.0,
  "end_sec": 266.0,
  "text": "マジですか?"
 },
 {
  "start_sec": 266.0,
  "end_sec": 267.0,
  "text": "マジですマジです"
 },
 {
  "start_sec": 267.0,
  "end_sec": 268.0,
  "text": "いつもサボってる"
 },
 {
  "start_sec": 268.0,
  "end_sec": 271.82,
  "text": "はははははは"
 },
 {
  "start_sec": 270.0,
  "end_sec": 272.0,
  "text": "あ、そうですか、めちゃくちゃかかい"
 },
 {
  "start_sec": 273.0,
  "end_sec": 274.0,
  "text": "ピースは?"
 },
 {
  "start_sec": 274.0,
  "end_sec": 275.0,
  "text": "ピースできる?"
 },
 {
  "start_sec": 275.0,
  "end_sec": 277.0,
  "text": "あ、ピースできた"
 },
 {
  "start_sec": 278.0,
  "end_sec": 280.0,
  "text": "すごい、俺が満載的やるのやつと一緒"
 },
 {
  "start_sec": 281.0,
  "end_sec": 283.0,
  "text": "1個引いて1個出せる"
 },
 {
  "start_sec": 283.0,
  "end_sec": 284.0,
  "text": "知ってくれたよな"
 },
 {
  "start_sec": 285.0,
  "end_sec": 287.0,
  "text": "え、ちょっといいですか?すいません"
 },
 {
  "start_sec": 287.0,
  "end_sec": 288.0,
  "text": "いや、すいません"
 },
 {
  "start_sec": 288.0,
  "end_sec": 290.0,
  "text": "おしゃべれなんですよ"
 },
 {
  "start_sec": 291.0,
  "end_sec": 294.0,
  "text": "コーンも1個1個手焼きで焼いてて"
 },
 {
  "start_sec": 294.0,
  "end_sec": 296.0,
  "text": "コーンが手焼きなんですか?"
 },
 {
  "start_sec": 296.0,
  "end_sec": 299.0,
  "text": "これワイフルコーンの匂いやこれ"
 },
 {
  "start_sec": 300.0,
  "end_sec": 301.1,
  "text": "うわ、なにそれ?"
 },
 {
  "start_sec": 301.1,
  "end_sec": 302.7,
  "text": "めっちゃ美味しそうじゃん"
 },
 {
  "start_sec": 304.3,
  "end_sec": 306.3,
  "text": "えぇ、手焼きのはフルコーン?"
 },
 {
  "start_sec": 306.3,
  "end_sec": 307.7,
  "text": "めっちゃ食べたい"
 },
 {
  "start_sec": 307.7,
  "end_sec": 309.3,
  "text": "お店は繁盛してますか?どうですか?"
 },
 {
  "start_sec": 309.3,
  "end_sec": 310.0,
  "text": "ぶちぶち"
 },
 {
  "start_sec": 310.0,
  "end_sec": 310.8,
  "text": "ぶちぶちして"
 },
 {
  "start_sec": 310.8,
  "end_sec": 313.7,
  "text": "そして、映画をしてはるもん2人とも"
 },
 {
  "start_sec": 313.7,
  "end_sec": 315.7,
  "text": "もっと雑貨屋とかやってて"
 },
 {
  "start_sec": 315.7,
  "end_sec": 317.2,
  "text": "他の地域で"
 },
 {
  "start_sec": 317.2,
  "end_sec": 317.8,
  "text": "なるほど"
 },
 {
  "start_sec": 317.8,
  "end_sec": 320.8,
  "text": "アメリカとかいろんな所に買い付けに行ってたんですか?"
 },
 {
  "start_sec": 320.8,
  "end_sec": 321.8,
  "text": "もう買い付けされてた?"
 },
 {
  "start_sec": 321.8,
  "end_sec": 322.7,
  "text": "そうですね"
 },
 {
  "start_sec": 322.7,
  "end_sec": 326.2,
  "text": "その時にアイスが好きで食べ歩きをしててアイスの"
 },
 {
  "start_sec": 326.2,
  "end_sec": 326.8,
  "text": "はい"
 },
 {
  "start_sec": 326.8,
  "end_sec": 328.8,
  "text": "日本でアイスクリームやって"
 },
 {
  "start_sec": 328.8,
  "end_sec": 329.8,
  "text": "なんかジェラーとやつ"
 },
 {
  "start_sec": 330.0,
  "end_sec": 334.52,
  "text": "多いんですけど、アイスクリームっていうお店ってなかなか少ないねって"
 },
 {
  "start_sec": 334.52,
  "end_sec": 337.28,
  "text": "確かに、もうチェーン店とかのイメージになっちゃいますよね"
 },
 {
  "start_sec": 337.28,
  "end_sec": 338.08,
  "text": "そうです、そうです"
 },
 {
  "start_sec": 338.08,
  "end_sec": 340.6,
  "text": "主人はもともと建築で家を作ってたんですけど"
 },
 {
  "start_sec": 340.6,
  "end_sec": 341.76,
  "text": "なんか多いな情報"
 },
 {
  "start_sec": 341.76,
  "end_sec": 342.36,
  "text": "そうです、そうです"
 },
 {
  "start_sec": 342.36,
  "end_sec": 343.16,
  "text": "すごいです"
 },
 {
  "start_sec": 343.16,
  "end_sec": 344.36,
  "text": "建築を作られてた"
 },
 {
  "start_sec": 344.36,
  "end_sec": 346.44,
  "text": "ここの家もここ建てたのも知らない"
 },
 {
  "start_sec": 346.44,
  "end_sec": 347.16,
  "text": "そうです"
 },
 {
  "start_sec": 347.16,
  "end_sec": 347.64,
  "text": "すごいね"
 },
 {
  "start_sec": 347.64,
  "end_sec": 348.96,
  "text": "これ建て合ったんや"
 },
 {
  "start_sec": 350.96,
  "end_sec": 352.04,
  "text": "えぇ、すご"
 },
 {
  "start_sec": 352.04,
  "end_sec": 353.92,
  "text": "ガチで作ってんのよ、じゃあ"
 },
 {
  "start_sec": 353.92,
  "end_sec": 354.8,
  "text": "たくみだ"
 },
 {
  "start_sec": 358.08,
  "end_sec": 358.96,
  "text": "うまそう、ごめんなさい"
 },
 {
  "start_sec": 358.96,
  "end_sec": 359.46,
  "text": "いただきます"
 },
 {
  "start_sec": 360.0,
  "end_sec": 361.0,
  "text": "うわ、いいね"
 },
 {
  "start_sec": 364.6,
  "end_sec": 366.0,
  "text": "めっちゃうまい!"
 },
 {
  "start_sec": 366.0,
  "end_sec": 367.0,
  "text": "何これ?"
 },
 {
  "start_sec": 367.0,
  "end_sec": 368.0,
  "text": "クリームチーズ"
 },
 {
  "start_sec": 368.0,
  "end_sec": 371.0,
  "text": "うわー、チーズの香りと味めっちゃしっかりするのに重たくない"
 },
 {
  "start_sec": 371.0,
  "end_sec": 373.0,
  "text": "保健の妄想ですよ"
 },
 {
  "start_sec": 373.0,
  "end_sec": 375.0,
  "text": "そう、ずっとうまい"
 },
 {
  "start_sec": 375.0,
  "end_sec": 377.0,
  "text": "食べ歩きも向いてる!"
 },
 {
  "start_sec": 377.0,
  "end_sec": 379.0,
  "text": "ジョーカマチーズにアイス"
 },
 {
  "start_sec": 379.0,
  "end_sec": 381.0,
  "text": "ね、ほんとですね"
 },
 {
  "start_sec": 383.0,
  "end_sec": 385.0,
  "text": "サムネにアザトウイも入れましょう"
 },
 {
  "start_sec": 385.0,
  "end_sec": 387.0,
  "text": "ゴジェジェは意外とアザトウイも入れましょう"
 },
 {
  "start_sec": 387.0,
  "end_sec": 389.0,
  "text": "オンラインもあるんで"
 },
 {
  "start_sec": 389.0,
  "end_sec": 391.0,
  "text": "オンラインもあるんだけど"
 },
 {
  "start_sec": 390.0,
  "end_sec": 392.0,
  "text": "買ってください"
 },
 {
  "start_sec": 394.0,
  "end_sec": 396.0,
  "text": "もうあざっという風吹でいきましょうか"
 },
 {
  "start_sec": 396.0,
  "end_sec": 398.0,
  "text": "ご主人だけじゃなかったよね"
 },
 {
  "start_sec": 398.0,
  "end_sec": 400.0,
  "text": "でもお前が引っ張ってる"
 },
 {
  "start_sec": 400.0,
  "end_sec": 401.0,
  "text": "うまそうだっていう"
 },
 {
  "start_sec": 401.0,
  "end_sec": 403.0,
  "text": "でもたぶちなんか普通になかった"
 },
 {
  "start_sec": 403.0,
  "end_sec": 404.0,
  "text": "そう"
 },
 {
  "start_sec": 404.0,
  "end_sec": 406.0,
  "text": "意外と普通にやってる"
 },
 {
  "start_sec": 406.0,
  "end_sec": 408.0,
  "text": "1人の方がすんなに見れるな"
 },
 {
  "start_sec": 409.0,
  "end_sec": 411.0,
  "text": "2人が今回調査するのは"
 },
 {
  "start_sec": 411.0,
  "end_sec": 413.0,
  "text": "愛知県犬山市"
 },
 {
  "start_sec": 413.0,
  "end_sec": 416.0,
  "text": "幻想する日本最古の天使と言われる"
 },
 {
  "start_sec": 416.0,
  "end_sec": 420.0,
  "text": "ココホイネヤマジョウが待ちの人を"
 },
 {
  "start_sec": 420.0,
  "end_sec": 425.0,
  "text": "その状況なちには、歴史や文化を伝える名称はもちろんのこと"
 },
 {
  "start_sec": 425.0,
  "end_sec": 430.0,
  "text": "かわいい食べ歩きルルメやSNS売するカフェなのも存在"
 },
 {
  "start_sec": 430.0,
  "end_sec": 436.0,
  "text": "さらには愛知県民なら、定番の永続スポット、日本モンキーパークや"
 },
 {
  "start_sec": 436.0,
  "end_sec": 443.0,
  "text": "およそ1300年の歴史を誇る基礎がわんかいなど、見どころもたくさん"
 },
 {
  "start_sec": 443.0,
  "end_sec": 448.0,
  "text": "緊急が見事に融合した人気観光都市でいざ長長人探し"
 },
 {
  "start_sec": 450.0,
  "end_sec": 453.76,
  "text": "さあというわけで次一レギュラー2回目の放送でございますけれども"
 },
 {
  "start_sec": 453.76,
